COMMON_GROUND_URL=

# Manager account. The manager always creates the Discussion.
REQUESTOR_EMAIL=
REQUESTOR_PASSWORD=

# Employee account. The employee accepts the invitation and shares first.
PARTICIPANT_EMAIL=
PARTICIPANT_PASSWORD=

# Optional for later LLM-driven interview responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_JUDGE_MODEL=gpt-4.1-nano
# Use config/selectors.example.json until real production selectors are mapped.
SELECTORS_PATH=config/selectors.local.json

# Comma-separated phrases that indicate the Getting Started interview is complete.
COMPLETION_PHRASES=

HEADLESS=true
SLOW_MO_MS=0
MAX_TURNS=25
POST_COMPLETION_WAIT_MS=

# Optional: path to an intercepting-proxy root CA (e.g. Norton Web/Mail Shield).
# Only needed if local antivirus/proxy re-signs HTTPS traffic and OpenAI calls
# fail with UNABLE_TO_VERIFY_LEAF_SIGNATURE. By default the launcher also checks
# config/certs/norton-root.pem and .tmp/norton-root.pem. See config/certs/README.md.
EXTRA_CA_CERTS_PATH=
